DOC_EXT = {b'md', b'markdown', b'rst', b'txt', b'adoc', b'org', b'tex', b'rtf'}
# 文件層只認**完全相同**的主檔名（第一個 `.` 之前），且副檔名是文件副檔名或沒有副檔名：
# security.py、history.js、changes.sh 仍是原始碼（#45 verify round 2 #5：舊版以前綴比對，把它們排到文件層）。
