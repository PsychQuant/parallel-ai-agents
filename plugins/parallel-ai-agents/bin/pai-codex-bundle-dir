# `.env` 開頭的**任何**檔名都算（.env、.env.local、.env-prod、.env_local、.envs、.envrc、.env.example…）
# ——SKILL.md 寫的是 `.env*`，範本檔也不例外（#45 verify round 2 #8）。
SECRET_NAMES = {
