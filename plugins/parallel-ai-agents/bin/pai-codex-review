#!/usr/bin/env bash
# pai-codex-review — codex leg 的管線單一真相源（#37 follow-up）
#
# 把 instructions + artifact 組成 prompt 檔、以背景方式跑 codex-call、讓呼叫端用
# 分開的 poll 逐次查詢，並保證清理與總期限。
#
# 用法：
#   pai-codex-review start --wrapper <codex-call> --model <m> --effort <e> \
#                          --max-time <s> --instructions <text> \
#                          [--artifact <file>] [--service-tier <t>]
#       → stdout 印出 RUNDIR（一行）；立即返回，不阻塞。
#   pai-codex-review poll <RUNDIR> [--output <file>]
#       → stdout 印出 RUNNING / "DONE <path>" / FAILED / TIMEOUT（一行）；立即返回。
#         DONE 時把結果搬到 --output（預設為一個 mktemp 產生的不可預測路徑）並清掉 RUNDIR。
#   pai-codex-review abort <RUNDIR>
#       → kill 子程序並清掉 RUNDIR。
#
# 退出碼：
#   0  正常（start 成功 / poll 成功回報狀態，含 RUNNING）
#   1  參數錯誤 / 前置條件不符（artifact 不是可讀的一般檔案、RUNDIR 不合法等）
#   2  codex-call 失敗（poll 回 FAILED 時併用）
#   3  超過總期限或狀態損毀（poll 回 TIMEOUT 時併用；子程序已被 kill）
#
# 為什麼存在（#37 follow-up 的六個 findings 共同根因）：
#   2.22.1 把 mktemp / cat / nohup / 輪詢 / 清理全部**手寫進 prompt 字串**讓 LLM
#   組 shell。後果：JSON.stringify() 被當成 shell escaping、model/effort 沒 quote、
#   shell 變數不跨 tool call、nohup 留 orphan、輪詢無總期限、宣稱只收 regular file
#   卻不驗證。全部是「讓 LLM 寫 shell」造成的。本腳本把管線收回程式碼，比照
#   bin/pai-build-diff 的單一真相源戒律：要改管線就改這裡並更新
#   test/pai-codex-review.bats。
#
# 狀態存在 RUNDIR 的檔案裡，不靠 shell 變數 —— 也讓 poll 能是分開的 tool call
# （每次呼叫本身就是 runtime 眼中的 progress 事件）。
#
# ── PR #47 verify round 1 修正（8 blocking）────────────────────────────────
#   F1  每個帶值旗標前檢查 `$# -ge 2`。原本 `shift 2` 在只剩 1 個參數時**失敗且
#       不位移**，而本腳本無 `set -e` ⇒ while 迴圈永久空轉。malformed invocation
#       會 hang —— 正是 #37 要消滅的 no-progress 類別。
#   F2  `${TIER_ARGS[@]+"${TIER_ARGS[@]}"}`。空陣列展開在 bash < 4.4 + `set -u`
#       是 unbound variable，而 macOS 內建 /bin/bash 就是 3.2。錯誤發生在 `&` 的
#       背景子 shell ⇒ 父 shell 照樣印 RUNDIR、exit 0，wrapper 從未啟動。
#   F5  OUTFILE 不再走可預測的 sibling path，改用 mktemp；且寫入前拒 symlink。
#       舊的 `${RUNDIR}.result.md` 在 world-writable /tmp 上等於任意檔案覆寫原語。
#   F6  PID 必須是正整數，且 RUNDIR 必須帶本腳本寫的 run marker。舊版把任意目錄
#       裡的任意內容交給 kill ⇒「任意 PID kill ＋ 任意目錄 rm -rf」。
#   F8  supervisor 記錄 wrapper 的 exit status；DONE 同時要求 status=0 與非空輸出。
#       舊版只看輸出非空 ⇒ 寫出半截錯誤再非零退出會被當成成功。
#   F14 輸出搬移失敗不再被吞掉：失敗則回 FAILED 並保留 RUNDIR 供診斷。
#   F15 deadline 內容必須是正整數，否則 fail-closed（kill + TIMEOUT）。舊版讓
#       `[` 報錯後落到 RUNNING ⇒ 總期限被靜默停用。
#   orphan  supervisor 收到 TERM 時先 kill 自己的 wrapper 子程序才退出。
#   BLOCK   supervisor 的 stdout/stderr **必須**導離呼叫端的 pipe。呼叫端用
#           `RUNDIR=$(pai-codex-review start ...)`（文件教的寫法）時，command
#           substitution 會等到**所有持有該 pipe 的程序**結束才返回 —— supervisor
#           繼承 stdout 就會讓 `start` 阻塞到整個 codex run 跑完，非阻塞設計全毀，
#           而且是靜默的（呼叫端照樣拿到 RUNDIR，只是要等十分鐘）。stdin 一併導
#           自 /dev/null，避免背景程序搶終端輸入。

set -uo pipefail

err() { printf '%s\n' "$*" >&2; }
usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

# F1：帶值旗標的共用守衛。$1=旗標名 $2=剩餘參數個數
need_value() {
  [ "$2" -ge 2 ] || { err "$1 需要一個值"; exit 1; }
}

is_pos_int() {  # F6/F15：嚴格正整數（拒空、拒負、拒前綴零以外的非數字）
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) [ "$1" -gt 0 ] 2>/dev/null ;;
  esac
}

SUB="${1:-}"
case "$SUB" in
  -h|--help) usage; exit 0 ;;
  start|poll|abort) shift ;;
  *) err "用法錯誤：第一個參數必須是 start / poll / abort"; usage >&2; exit 1 ;;
esac

# ─────────────────────────────── start ───────────────────────────────
if [ "$SUB" = "start" ]; then
  WRAPPER=""; MODEL=""; EFFORT=""; MAXTIME=""; INSTRUCTIONS=""; ARTIFACT=""; TIER=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --wrapper)      need_value "$1" $#; WRAPPER="$2"; shift 2 ;;
      --model)        need_value "$1" $#; MODEL="$2"; shift 2 ;;
      --effort)       need_value "$1" $#; EFFORT="$2"; shift 2 ;;
      --max-time)     need_value "$1" $#; MAXTIME="$2"; shift 2 ;;
      --instructions) need_value "$1" $#; INSTRUCTIONS="$2"; shift 2 ;;
      --artifact)     need_value "$1" $#; ARTIFACT="$2"; shift 2 ;;
      --service-tier) need_value "$1" $#; TIER="$2"; shift 2 ;;
      *) err "未知參數：$1"; exit 1 ;;
    esac
  done

  [ -n "$WRAPPER" ] || { err "--wrapper 必填"; exit 1; }
  [ -x "$WRAPPER" ] || { err "--wrapper 不是可執行檔：$WRAPPER"; exit 1; }
  [ -n "$MODEL" ] && [ -n "$EFFORT" ] || { err "--model 與 --effort 必填"; exit 1; }
  is_pos_int "$MAXTIME" || { err "--max-time 必須是正整數，得到：$MAXTIME"; exit 1; }

  # 宣稱只收 regular file 就要真的驗證。先驗 symlink 再驗 -f —— `-f` 對
  # symlink-to-regular-file 回 true，順序反了等於沒擋。
  # 誠實邊界：這只守路徑的最後一段，parent-dir symlink 與 TOCTOU 仍在射程外
  # （要根治需一次安全 open + fstat，見 #35 的契約討論）。
  if [ -n "$ARTIFACT" ]; then
    [ -L "$ARTIFACT" ] && { err "--artifact 是 symlink，拒絕：$ARTIFACT"; exit 1; }
    [ -f "$ARTIFACT" ] || { err "--artifact 不是一般檔案：$ARTIFACT"; exit 1; }
    [ -r "$ARTIFACT" ] || { err "--artifact 不可讀：$ARTIFACT"; exit 1; }
  fi

  RUNDIR="$(mktemp -d -t pai-codex-review.XXXXXX)" || { err "mktemp -d 失敗"; exit 1; }

  # F6：run marker —— poll/abort 靠它確認這個目錄真的是本腳本建立的，
  # 而不是只看「有沒有一個叫 pid 的檔」（那個檢查任何人都能滿足）。
  printf 'pai-codex-review\n' > "$RUNDIR/.pai-run" || {
    err "寫 run marker 失敗"; rm -rf "$RUNDIR"; exit 1; }

  # instructions 用 printf 寫檔 —— 不經 shell 展開，內容任意皆安全
  printf '%s\n\n' "$INSTRUCTIONS" > "$RUNDIR/instr.txt" || {
    err "寫 instructions 失敗"; rm -rf "$RUNDIR"; exit 1; }

  # 只傳 path 的串接：artifact 的 bytes 不經任何命令列，也不經任何 agent 的 context
  if [ -n "$ARTIFACT" ]; then
    cat "$RUNDIR/instr.txt" "$ARTIFACT" > "$RUNDIR/prompt.txt" || {
      err "組 prompt 失敗"; rm -rf "$RUNDIR"; exit 1; }
  else
    cp "$RUNDIR/instr.txt" "$RUNDIR/prompt.txt" || {
      err "組 prompt 失敗"; rm -rf "$RUNDIR"; exit 1; }
  fi

  # deadline 存檔（輪詢必須有總期限）。grace 給 codex-call 自己收尾。
  printf '%s\n' "$(( $(date +%s) + MAXTIME + 30 ))" > "$RUNDIR/deadline" || {
    err "寫 deadline 失敗"; rm -rf "$RUNDIR"; exit 1; }

  # F2：空陣列在 bash 3.2 + set -u 會 unbound；`${arr[@]+"${arr[@]}"}` 是
  # 三版皆安全的展開形式。
  TIER_ARGS=()
  [ -n "$TIER" ] && TIER_ARGS=(--service-tier "$TIER")

  # F8 + orphan：supervisor 子 shell 負責 (a) 記錄 wrapper 的 exit status、
  # (b) 收到 TERM 時先殺自己的 wrapper 子程序再退出。記錄的 PID 是 supervisor。
  # 所有值都是 argv 元素、不經 shell 再解析一次 —— 無注入面。
  (
    "$WRAPPER" --output "$RUNDIR/out.md" --model "$MODEL" --effort "$EFFORT" \
               ${TIER_ARGS[@]+"${TIER_ARGS[@]}"} --max-time "$MAXTIME" \
               --instructions "$INSTRUCTIONS" --prompt-file "$RUNDIR/prompt.txt" \
               > "$RUNDIR/run.log" 2>&1 &
    CPID=$!
    printf '%s\n' "$CPID" > "$RUNDIR/child_pid"
    trap 'kill "$CPID" 2>/dev/null; exit 143' TERM INT
    wait "$CPID"
    printf '%s\n' "$?" > "$RUNDIR/status"
  ) > "$RUNDIR/supervisor.log" 2>&1 < /dev/null &
  printf '%s\n' "$!" > "$RUNDIR/pid"

  printf '%s\n' "$RUNDIR"
  exit 0
fi

# ──────────────────────────── poll / abort ────────────────────────────
RUNDIR="${1:-}"
[ -n "$RUNDIR" ] || { err "需要 RUNDIR 參數"; exit 1; }
[ -d "$RUNDIR" ] || { err "RUNDIR 不存在：$RUNDIR"; exit 1; }
# F6：run marker 是「這是本腳本建立的」的實際證據。錯誤訊息不得宣稱比檢查更強的事。
[ -f "$RUNDIR/.pai-run" ] || { err "RUNDIR 缺 run marker，不是本腳本建立的：$RUNDIR"; exit 1; }
[ -f "$RUNDIR/pid" ] || { err "RUNDIR 缺 pid 檔：$RUNDIR"; exit 1; }
shift

PID="$(cat "$RUNDIR/pid" 2>/dev/null || echo '')"
is_pos_int "$PID" || { err "pid 檔內容不是正整數，拒絕：${PID:-<空>}"; exit 1; }
CHILD_PID="$(cat "$RUNDIR/child_pid" 2>/dev/null || echo '')"

kill_child() {
  # 先 TERM supervisor（它的 trap 會收掉 wrapper），再兜底直接收 wrapper。
  kill "$PID" 2>/dev/null || true
  for _ in 1 2 3 4; do
    kill -0 "$PID" 2>/dev/null || break
    sleep 0.5
  done
  kill -9 "$PID" 2>/dev/null || true
  if is_pos_int "$CHILD_PID"; then
    kill "$CHILD_PID" 2>/dev/null || true
    sleep 0.2
    kill -9 "$CHILD_PID" 2>/dev/null || true
  fi
}

if [ "$SUB" = "abort" ]; then
  kill_child
  rm -rf "$RUNDIR"
  printf 'ABORTED\n'
  exit 0
fi

# F5：預設輸出改用 mktemp —— 不可預測，取代舊的 `${RUNDIR}.result.md` sibling path
# （在 world-writable /tmp 上那是任意檔案覆寫原語）。
OUTFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --output) need_value "$1" $#; OUTFILE="$2"; shift 2 ;;
    *) err "未知參數：$1"; exit 1 ;;
  esac
done

finish() {  # $1=狀態字串 $2=退出碼
  if [ "$1" = "DONE" ]; then
    if [ -z "$OUTFILE" ]; then
      OUTFILE="$(mktemp -t pai-codex-review-result.XXXXXX)" || {
        err "mktemp 結果檔失敗"; printf 'FAILED\n'; exit 2; }
    fi
    # F5：拒絕寫穿 symlink。
    [ -L "$OUTFILE" ] && { err "--output 是 symlink，拒絕寫入：$OUTFILE"; printf 'FAILED\n'; exit 2; }
    # F14：搬移失敗不得被吞掉 —— 保留 RUNDIR 供診斷，回 FAILED。
    if ! cat "$RUNDIR/out.md" > "$OUTFILE" 2>/dev/null; then
      err "結果搬移失敗（保留 $RUNDIR 供診斷）：$OUTFILE"
      printf 'FAILED\n'; exit 2
    fi
    [ -f "$RUNDIR/run.log" ] && [ ! -L "${OUTFILE}.log" ] && \
      cat "$RUNDIR/run.log" > "${OUTFILE}.log" 2>/dev/null || true
    rm -rf "$RUNDIR"
    printf 'DONE %s\n' "$OUTFILE"
    exit "$2"
  fi
  rm -rf "$RUNDIR"
  printf '%s\n' "$1"
  exit "$2"
}

if kill -0 "$PID" 2>/dev/null; then
  # 還活著 —— 但先看有沒有超過總期限
  NOW="$(date +%s)"
  DEADLINE="$(cat "$RUNDIR/deadline" 2>/dev/null || echo '')"
  # F15：deadline 損毀 ⇒ fail-closed。舊版讓 `[` 報錯後落到 RUNNING，
  # 等於總期限被靜默停用 —— 損毀狀態不該換來「無限期繼續」。
  if ! is_pos_int "$DEADLINE"; then
    err "deadline 狀態損毀（${DEADLINE:-<空>}）—— fail-closed"
    kill_child
    finish "TIMEOUT" 3
  fi
  if [ "$NOW" -gt "$DEADLINE" ]; then
    kill_child
    finish "TIMEOUT" 3
  fi
  printf 'RUNNING\n'
  exit 0
fi

# 已結束。F8：DONE 需要 exit status 0 **且** 非空輸出。
# 舊版只看輸出非空 ⇒ wrapper 寫出半截錯誤再非零退出會被當成成功。
STATUS="$(cat "$RUNDIR/status" 2>/dev/null || echo '')"
if [ "$STATUS" = "0" ] && [ -s "$RUNDIR/out.md" ]; then
  finish "DONE" 0
fi
finish "FAILED" 2
