      "expectLens": ["reference-verifier"],
      "match_any": ["tanaka", "whitfield"]
    },
    {
      "id": "wrong-mean",
      "desc": "gain 組平均：paper 寫 M=5.42，ground truth mean_gain=4.42",
      "expectLens": ["number-verifier"],
      "match_any": ["5.42", "4.42"]
    },
    {
      "id": "wrong-t",
      "desc": "t 統計量：paper 寫 t(100)=6.34 / p<.001，ground truth t=2.79 / p=0.03",
